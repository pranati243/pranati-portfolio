# Copy to .env.local for local `vercel dev`, and set the same key in
# Vercel → Project Settings → Environment Variables for production.
#
# This key is read ONLY inside api/ask.js (server side). It is never bundled
# into the browser build — do not rename it to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=your-google-ai-studio-key-here

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
CHAT_TIMEOUT_MS=12000
